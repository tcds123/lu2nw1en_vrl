# 忽略 Python 缓存文件 (必须)
__pycache__/
*.pyc

# 忽略虚拟环境 (如果你把环境装在项目里了，这会有几万个文件)
venv/
env/
.venv/
anaconda3/
miniconda3/
bin/
lib/
lib64/
lunwen/
tensorboard_log/

# 忽略大型数据集 (不要上传数据集到 GitHub！)
data/
dataset/
datasets/
models/
outputs/
evalplus_results/
LiveCodeBench/

# 忽略训练产生的大模型权重和日志
*.pth
*.pt
*.ckpt
*.safetensors
logs/
wandb/
runs/
a_model_grpo_standard/
a_model_grpo_10/
a_model_grpo_0209/
a_model_grpo_standard_0206/
a_model_grpo_standard_1229/
a_model_grpo_standard_0106/
a_model_grpo_standard_0121/
a_model_grpo_standard_0123_base/

# 训练产物: checkpoint 权重与数据缓存 (a_model_grpo_standard_0615 等, 体积巨大)
a_model_grpo_*/
*_0615/
checkpoints/
data_cache/

# 压缩包 (全局屏蔽, 含 for_review/ 下的 zip)
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.bz2

# for_review/: 只屏蔽压缩包的解压副本 (大体积冗余), 本体 code/data/docs/results 保留提交
for_review/archive/
for_review/gpt_review_extracted/
for_review/**/__MACOSX/

# 备份文件 (*.bak / *.bak_phase2 / *.bak.phaseD / backups)
outputs_backup/
*.bak
*.bak_*/
*.bak.phase*

# 第三方拷贝的 Agent 框架 (非本项目代码, 体积大: nanobot 88M / smolagents 11M / sema-code-core)
agent/nanobot/
agent/smolagents/
agent/sema-code-core/

# 本地运行时/日志/锁文件
proxy/
*.log
*.lock
*.chk

# 一次性密钥脱敏迁移脚本 (内含全部真实 key 映射, 不可提交)
.key_redact.py

# 本地 Claude 配置 (含 settings.local.json, 可能有 key)
.claude/


# 忽略 IDE 配置文件
.idea/
.vscode/