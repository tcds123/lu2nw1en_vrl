# 跨模型评测模型 API key (Midea AIMP 网关)
#
# 用法: 复制本文件 -> .env, 填入真实 key, 然后:  set -a; source .env; set +a
#   或直接 export 这三个变量。
#
# key 来源: SmartPad/evaluation/cc_switch_compare/config/models_aimp.yaml (明文, 本地保留)
# configs/models_aimp.yaml 通过 ${AIMP_KEY_*} 占位符读取。
#
# ⚠️ .env (含真实 key) 已被 .gitignore 排除, 不要提交到 GitHub。

# deepseek-v4-flash 专用 key
export AIMP_KEY_FLASH=

# deepseek-v4-pro 专用 key
export AIMP_KEY_PRO=

# glm-5.2 专用 key (AIMP 专有端点, 另需 AIGC-USER header)
export AIMP_KEY_GLM=
